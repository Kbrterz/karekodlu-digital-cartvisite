      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nlet d = item.body;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = {}; } }\nif (!d || typeof d !== 'object') d = {};\n\nconst clean = (s, n = 300) => String(s == null ? '' : s).replace(/\\s+/g, ' ').trim().slice(0, n);\nconst name = clean(d.name, 120);\nconst title = clean(d.title, 120);\nconst company = clean(d.company, 120);\nconst email = clean(d.email, 180).toLowerCase();\nconst cv = clean(d.cv, 400);\nconst hp = clean(d.website_hp, 50);\nconst source = clean(d.source, 60) || 'dijital-kartvizit';\n\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst ok = !hp && !!name && !!title && !!company && emailOk;\nconst reason = hp ? 'honeypot' : ((!name || !title || !company) ? 'missing_fields' : (!emailOk ? 'bad_email' : 'ok'));\n\nconst tarih = new Date().toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' });\n\nreturn [{ json: {\n  ok: ok,\n  reason: reason,\n  'Tarih': tarih,\n  'Ad Soyad': name,\n  'Ünvan': title,\n  'İşyeri': company,\n  'E-posta': email,\n  'CV Linki': cv,\n  'Kaynak': source\n} }];"
      }
    },
